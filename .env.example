# ═══════════════════════════════════════════════════════════════════════════
# AFSB – modelo de configuração (backend + frontend).
# Copie para .env na raiz e preencha:  cp .env.example .env
# Valores entre aspas simples são literais (o compose não interpreta $ neles).
# ═══════════════════════════════════════════════════════════════════════════

# ── DJANGO ─────────────────────────────────────────────────────────────────
# Obrigatória. Gerar: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY='troque-por-uma-chave-longa-e-aleatoria'
# 1 só em desenvolvimento.
DJANGO_DEBUG=0
# Domínios aceitos, separados por vírgula. "backend" é o host que o nginx usa no compose.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── E-MAIL ─────────────────────────────────────────────────────────────────
# Sem EMAIL_HOST os e-mails só aparecem no console do backend.
DJANGO_DEFAULT_FROM_EMAIL='AFSB <nao-responda@afsb.com.br>'
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# ── ARQUIVOS (Backblaze B2, S3 compatível) ─────────────────────────────────
# Backblaze → App Keys → Add a New Application Key (acesso só ao bucket).
B2_BUCKET_NAME=
B2_REGION=us-east-005
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_ACCESS_KEY=
B2_SECRET_KEY=''

# ── ASAAS ──────────────────────────────────────────────────────────────────
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Asaas → perfil → Integrações → Gerar API Key. Manter entre aspas simples (começa com $).
ASAAS_API_KEY=''
# Token inventado (openssl rand -hex 32), cadastrado igual em Asaas → Integrações → Webhooks.
ASAAS_WEBHOOK_TOKEN=
# Trava: nenhum boleto é emitido até a AFSB comunicar os associados. Liberar com 1.
COBRANCA_EMISSAO_LIBERADA=0

# ── FRONTEND (Vite em dev) ─────────────────────────────────────────────────
# Para onde o `npm run dev` encaminha /api.
API_ALVO=http://localhost:8000
